#!/usr/bin/env bash
# Gate the push that updates the integration branch.
#
# The gate itself lives in `scripts/push-gate.sh`, because `scripts/land.sh` runs
# the same suites before it opens the connection: git talks to the remote before
# this hook runs, so a long gate here holds an idle connection and the push can
# die with SIGPIPE after the suites pass (measured 2026-11-19). This hook stays
# for a hand-run `git push`, so no push of `main` goes ungated by accident.
#
# `SKIP_PUSH_GATE=1` is for a deliberately red branch — the push is then a
# request for review, not an integration — and for the push `land.sh` already
# gated.
set -euo pipefail

[ "${SKIP_PUSH_GATE:-0}" = 1 ] && exit 0

integration=refs/heads/main
repository=$(git rev-parse --show-toplevel)
cd -- "$repository"

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "$integration" ] || continue
    # A deletion moves nothing into the integration branch.
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        exec bash scripts/push-gate.sh "" "$local_sha"
    fi
    exec bash scripts/push-gate.sh "$remote_sha" "$local_sha"
done
