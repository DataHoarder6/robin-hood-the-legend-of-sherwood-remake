{
  "schema": 1,
  "id": "H18",
  "proves": { "layer": "transport", "tests": [
      "robin_rs::multiplayer::tests::host_content_preflight_uses_no_seat_then_exact_resume_reconnects"
  ] },
  "peers": [
    { "seat": 0, "role": "host" },
    { "seat": 1, "role": "client" }
  ],
  "faults": [
    { "at": { "barrier": "content-ready", "after": 0 }, "peer": 1, "fault": "kill" }
  ],
  "expect": [
    { "assert": "barrier", "barrier": "content-ready", "state": "reached" },
    { "assert": "seat", "seat": 1, "owns": true }
  ]
